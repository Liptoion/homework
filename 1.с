
#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
int main(void)
{
	int a = 0;
	printf("Enter a number: ");
	scanf("%d", &a);
	if (a > 0)
	{
		printf("positive ");
	}
	else if (a < 0)
	{
		printf("negative ");
	}
	else
	{
		printf("zero ");
	}

	if (a % 2 == 0)
	{
		printf("even\n");
	}
	else
	{
		printf("odd\n");
	}
}